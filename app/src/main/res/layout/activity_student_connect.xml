<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_alt"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/studentConnectBackButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingEnd="12dp"
            android:text="‹  Back to app"
            android:textColor="@color/brand_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Student Connect"
            android:textColor="@color/ink_900"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="Set up a separate, recoverable identity for student-to-student features. Your current university login stays unchanged."
            android:textColor="@color/ink_500"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/studentConnectStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:text="Checking Student Connect status…"
                android:textColor="@color/ink_700"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/studentConnectAuthForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email address"
                android:textColor="@color/ink_700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/studentConnectEmailInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:autofillHints="emailAddress"
                android:backgroundTint="@color/brand_primary"
                android:hint="you@example.com"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_400"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Student Connect password"
                android:textColor="@color/ink_700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/studentConnectPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:autofillHints="newPassword"
                android:backgroundTint="@color/brand_primary"
                android:hint="At least 6 characters"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_400"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studentConnectCreateAccountButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="Create Student Connect account"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studentConnectSignInButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="I already have an account — Sign in"
                android:textAllCaps="false"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/surface"
                app:cornerRadius="14dp"
                app:strokeColor="@color/surface_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studentConnectSignedInPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Signed-in account"
                android:textColor="@color/ink_700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/studentConnectAccountEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="14dp"
                android:background="@drawable/bg_brand_card"
                android:textColor="@color/ink_900"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studentConnectResendVerificationButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Resend verification email"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studentConnectCheckVerificationButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="I've verified my email — check again"
                android:textAllCaps="false"
                android:textColor="@color/brand_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/surface"
                app:cornerRadius="14dp"
                app:strokeColor="@color/surface_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studentConnectSignOutButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Sign out of Student Connect"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                android:textSize="14sp"
                app:backgroundTint="@color/danger_bg"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studentConnectProfileSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create your student profile"
                android:textColor="@color/ink_900"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Choose the name classmates will see. Your email and ERP username are not added to the public profile."
                android:textColor="@color/ink_500"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/studentConnectDisplayNameInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:autofillHints="name"
                android:backgroundTint="@color/brand_primary"
                android:hint="Your display name"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="60"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_400"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studentConnectCreateProfileButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:text="Create my student profile"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studentConnectProfileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_brand_card"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your student profile"
                android:textColor="@color/ink_900"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Display name"
                android:textColor="@color/ink_500"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/studentConnectProfileDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink_900"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Unique student ID"
                android:textColor="@color/ink_500"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/studentConnectProfilePublicId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.08"
                android:textColor="@color/brand_primary"
                android:textSize="23sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studentConnectCopyPublicIdButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="Copy student ID"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studentConnectSearchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find Students"
                android:textColor="@color/ink_900"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Enter a classmate's complete public ID. Only their display name and public ID will be shown."
                android:textColor="@color/ink_500"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/studentConnectSearchInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/brand_primary"
                android:hint="UNI-XXXXXXX"
                android:inputType="textCapCharacters"
                android:maxLength="11"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_400"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studentConnectSearchButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Search by student ID"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="14dp" />

            <LinearLayout
                android:id="@+id/studentConnectSearchResultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_brand_card"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student found"
                    android:textColor="@color/ink_500"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/studentConnectSearchResultName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink_900"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/studentConnectSearchResultId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.06"
                    android:textColor="@color/brand_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:lineSpacingExtra="3dp"
            android:text="Security note: use a different password from your university ERP password. Keep access to this email so you can recover your Student Connect identity if you change phones."
            android:textColor="@color/ink_500"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

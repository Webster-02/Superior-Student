<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

        <FrameLayout
        android:id="@+id/loginScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#071426">

        <ImageView
            android:id="@+id/loginBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/login_background"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#26030B18"
            android:importantForAccessibility="no" />

        <ScrollView
            android:id="@+id/loginContentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants">

            <LinearLayout
                android:id="@+id/loginContentStack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="34dp">

                <View
                    android:id="@+id/loginTopSpacer"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_glass"
                android:elevation="16dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="15dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back"
                    android:textColor="@color/ink_900"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="11dp"
                    android:text="Sign in with your university account"
                    android:textColor="@color/ink_500"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/usernameInput"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:background="@drawable/bg_login_field_selector"
                    android:drawableStart="@drawable/ic_user"
                    android:drawablePadding="9dp"
                    android:hint="University roll number / username"
                    android:inputType="text|textNoSuggestions"
                    android:imeOptions="actionNext"
                    android:autofillHints="username"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#172033"
                    android:textColorHint="#667085"
                    android:fontFamily="sans"
                    android:gravity="center_vertical"
                    android:textSize="16sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_login_field_selector"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="9dp"
                        android:hint="University password"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:autofillHints="password"
                        android:paddingStart="12dp"
                        android:paddingEnd="64dp"
                        android:singleLine="true"
                        android:textColor="#172033"
                        android:textColorHint="#667085"
                        android:fontFamily="sans"
                        android:gravity="center_vertical"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/passwordVisibilityToggle"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="center"
                        android:text="Show"
                        android:textColor="@color/brand_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:contentDescription="Show password" />
                </FrameLayout>

                <Button
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_primary_button"
                    android:minHeight="48dp"
                    android:text="Sign in securely"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/loginStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:minHeight="14dp"
                    android:textColor="@color/danger"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Secure university sign in"
                    android:textColor="@color/ink_400"
                    android:textSize="8sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/sideMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="40dp"
        android:visibility="gone">

        <View
            android:id="@+id/menuScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#9908172B"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/sideMenu"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#FFFFFF"
            android:elevation="16dp"
            android:orientation="vertical"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mini ERP"
                        android:textColor="#123A70"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Superior Student"
                        android:textColor="#98A2B3"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/closeMenuButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Close menu"
                    android:padding="11dp"
                    android:src="@drawable/ic_back" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#E7ECF3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="20dp"
                android:text="ACCOUNT"
                android:textColor="#98A2B3"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/menuProfileButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="5dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:text="My Profile"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuStudentConnectButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:text="Student Connect"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuEnrolledCoursesButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:text="Enrolled Courses"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuInvoicesButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:text="Invoices"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuResultsButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:text="Results &amp; Grades"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="5dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:text="Appearance &amp; Theme"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#E7ECF3" />

            <TextView
                android:id="@+id/menuLogoutButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:text="Sign out"
                android:textColor="#C62828"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="SUPERIOR STUDENT"
                android:textColor="#C0C7D2"
                android:textSize="9sp"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="74dp">

        <LinearLayout
            android:id="@+id/dashboardScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <FrameLayout
                android:id="@+id/dashboardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/page_bg">

                <LinearLayout
                    android:id="@+id/welcomeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@android:color/transparent"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/homeDateLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=" "
                            android:textColor="@color/ink_500"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/studentName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Salam"
                            android:textColor="@color/ink_900"
                            android:textSize="26sp"
                            android:fontFamily="@font/poppins_medium"
                            android:letterSpacing="-0.02"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/studentAvatarInitial"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="12dp"
                        android:background="@color/lime"
                        android:gravity="center"
                        android:text="S"
                        android:textColor="@color/lime_ink"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium"
                        android:includeFontPadding="false"
                        android:contentDescription="Student avatar" />
                </LinearLayout>

                <!-- More remains the menu entry point; keep the existing binding ID hidden. -->
                <ImageButton
                    android:id="@+id/menuButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:visibility="gone"
                    android:contentDescription="Open menu"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_pt_menu" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/homeHeroContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:id="@+id/homeNextClassContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@color/peach"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/nextClassLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Next class"
                        android:textColor="@color/ink_500"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/homeNextClassTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=" "
                        android:textColor="@color/ink_900"
                        android:textSize="20sp"
                        android:fontFamily="@font/poppins_medium"
                        android:letterSpacing="-0.015"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/homeNextClassTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=" "
                        android:textColor="@color/ink_500"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/homeNextClassIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@color/ink_900">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_pt_arrow_right"
                        android:tint="@color/page_bg"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeBentoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cgpaCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@color/lavender"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/studentCgpaLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CGPA"
                        android:textColor="@color/ink_500"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/studentCgpa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/ink_900"
                        android:textSize="38sp"
                        android:fontFamily="@font/poppins_medium"
                        android:includeFontPadding="false"
                        android:fontFeatureSettings="tnum" />
                    <TextView
                        android:id="@+id/studentCgpaCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/ink_500"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:visibility="gone"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sgpaCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@color/sky"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/studentSgpaLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SGPA"
                        android:textColor="@color/ink_500"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/studentSgpa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/ink_900"
                        android:textSize="38sp"
                        android:fontFamily="@font/poppins_medium"
                        android:includeFontPadding="false"
                        android:fontFeatureSettings="tnum" />
                    <TextView
                        android:id="@+id/studentSgpaCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/ink_500"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:visibility="gone"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/quickAccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Quick access" />

            <LinearLayout
                android:id="@+id/homeShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/timetableButton"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="4dp"
                    android:background="@color/card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:minHeight="68dp"
                    android:contentDescription="Timetable" />

                <LinearLayout
                    android:id="@+id/resultsButton"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@color/card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:minHeight="68dp"
                    android:contentDescription="Results" />

                <LinearLayout
                    android:id="@+id/enrolledCoursesButton"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@color/card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:minHeight="68dp"
                    android:contentDescription="Courses" />

                <LinearLayout
                    android:id="@+id/profileButton"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="0dp"
                    android:background="@color/card_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:minHeight="68dp"
                    android:contentDescription="Profile" />
            </LinearLayout>

            <!-- Keep older binding targets without rendering additional shortcut tiles. -->
            <FrameLayout
                android:id="@+id/homeLegacyControls"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone">
                <LinearLayout android:id="@+id/attendanceButton" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/feeButton" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/dashboardBottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="16dp"
        android:background="@color/nav_bg"
        android:elevation="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="7dp"
        android:paddingTop="5dp"
        android:paddingEnd="7dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/navHomeButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@color/lime"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:contentDescription="Home">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pt_home" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:visibility="visible"
                android:text="Home"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/lime_ink"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTimetableButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="Timetable">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pt_calendar" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:visibility="gone"
                android:text="Timetable"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/nav_icon"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAttendanceButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="Attendance">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pt_clipboard" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:visibility="gone"
                android:text="Attendance"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/nav_icon"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navResultsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="Results">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pt_chart" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:visibility="gone"
                android:text="Results"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/nav_icon"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMoreButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="More">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pt_menu" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:visibility="gone"
                android:text="More"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/nav_icon"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/moduleScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F7FB"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/homeButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Back to dashboard"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/moduleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance"
                    android:textColor="#123A70"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/moduleSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Your attendance"
                    android:textColor="#98A2B3"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Refresh data"
                android:padding="11dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/moduleInfo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_info_banner"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="Updated from your student account"
            android:textColor="#235B9B"
            android:textSize="10sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/moduleScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/moduleContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp" />
            </ScrollView>

            <!-- Keep the student login UI independent of WebView provider startup. -->
            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible"
                android:importantForAccessibility="no" />

            <ProgressBar
                android:id="@+id/moduleProgress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>


</FrameLayout>

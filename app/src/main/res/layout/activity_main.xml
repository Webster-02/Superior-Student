<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/introScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/campusBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Superior University campus"
            android:scaleType="centerCrop"
            android:src="@drawable/campus" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#88000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Superior Student"
                android:textColor="@android:color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:text="Access your student portals easily"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/erpButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Open ERP"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/lmsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open LMS"
                android:textAllCaps="false" />
        </LinearLayout>
    </FrameLayout>

    <Button
        android:id="@+id/refreshButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:text="↻"
        android:visibility="gone" />

</FrameLayout>

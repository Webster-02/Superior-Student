<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp"
    android:forceDarkAllowed="false"
    android:background="@drawable/bg_student_connect_auth">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/studentChatHeaderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/sc_card"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sc_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/studentChatBrandEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.09"
                android:text="STUDENT CONNECT  /  DIRECT MESSAGES"
                android:textColor="@color/sc_lavender"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/studentChatBackButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="10dp"
                    android:text="‹ Back"
                    android:textColor="@color/sc_lavender"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardBackgroundColor="@color/sc_chat_avatar"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sc_border"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/studentChatAvatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_student_connect_chat_avatar"
                        android:gravity="center"
                        android:text="SC"
                        android:textColor="@color/sc_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/studentChatContactName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Classmate"
                        android:textColor="@color/sc_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/studentChatContactSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="ACCEPTED CONNECTION  •  PRIVATE CHAT"
                        android:textColor="@color/sc_text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/studentChatPresenceIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="Offline"
                        android:textColor="@color/sc_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/studentChatTypingIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="Typing…"
                        android:textColor="@color/sc_lavender"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="7dp"
                android:background="@color/sc_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="A direct line to your campus connection."
                android:textColor="@color/sc_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/studentChatStatusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/sc_chat_status"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sc_border"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/studentChatStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/sc_text_muted"
            android:textSize="12sp" />
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <ScrollView
            android:id="@+id/studentChatMessagesScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/studentChatMessagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingTop="8dp"
                android:paddingEnd="2dp"
                android:paddingBottom="8dp" />
        </ScrollView>

        <TextView
            android:id="@+id/studentChatEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="28dp"
            android:text="✦\nYour connection, your conversation.\nSend a message to get things started."
            android:textColor="@color/sc_text_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/studentChatComposerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/sc_card"
        app:cardCornerRadius="21dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sc_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="7dp">

            <LinearLayout
                android:id="@+id/studentChatReplyPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:background="@color/sc_chat_status"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="5dp"
                android:paddingBottom="7dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/studentChatReplyPreviewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Replying to classmate"
                        android:textColor="@color/sc_lavender"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/studentChatReplyPreviewBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/sc_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/studentChatReplyPreviewClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Cancel reply"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="@color/sc_text_muted"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/studentChatSelectedFilePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:background="@color/sc_chat_status"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="5dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/studentChatSelectedFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textColor="@color/sc_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/studentChatSelectedFileDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/sc_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/studentChatSelectedFileRemove"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Remove selected file"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="@color/sc_text_muted"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/studentChatAttachFileButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Attach file"
                    android:text="＋"
                    android:textAllCaps="false"
                    android:textColor="@color/sc_text_primary"
                    android:textSize="22sp"
                    app:backgroundTint="@color/sc_chat_status"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/sc_border"
                    app:strokeWidth="1dp" />

                <EditText
                    android:id="@+id/studentChatMessageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:maxHeight="112dp"
                    android:maxLength="2000"
                    android:autofillHints="none"
                    android:background="@drawable/bg_student_connect_input"
                    android:gravity="top|start"
                    android:hint="Message your connection…"
                    android:inputType="textCapSentences|textMultiLine"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/sc_text_primary"
                    android:textColorHint="@color/sc_text_muted"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/studentChatSendButton"
                    android:layout_width="78dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="Send"
                    android:textAllCaps="false"
                    android:textColor="@color/sc_text_primary"
                    android:textSize="13sp"
                    app:backgroundTint="@color/sc_purple"
                    app:cornerRadius="15dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

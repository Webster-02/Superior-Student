<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp"
    android:background="@color/surface_alt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/studentChatBackButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="14dp"
            android:text="‹ Back"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/studentChatContactName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Classmate"
                android:textColor="@color/ink_900"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Student Connect · Private chat"
                android:textColor="@color/ink_500"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/studentChatStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/ink_500"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/studentChatMessagesScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/studentChatMessagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingTop="6dp"
                android:paddingEnd="2dp"
                android:paddingBottom="8dp" />
        </ScrollView>

        <TextView
            android:id="@+id/studentChatEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="28dp"
            android:text="No messages yet.\nSend a message to start the conversation."
            android:textColor="@color/ink_500"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="@color/surface">

        <EditText
            android:id="@+id/studentChatMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:maxHeight="112dp"
            android:maxLength="2000"
            android:autofillHints="none"
            android:backgroundTint="@color/brand_primary"
            android:gravity="top|start"
            android:hint="Write a message…"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/ink_900"
            android:textColorHint="@color/ink_400"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/studentChatSendButton"
            android:layout_width="84dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Send"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>

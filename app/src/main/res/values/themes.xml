<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme; DayNight follows Paper, Night or system Auto. -->
    <style name="Theme.SuperiorStudent.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorSecondaryVariant">@color/brand_accent_deep</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorOnSecondary">@color/ink_900</item>
        <item name="android:colorBackground">@color/surface_alt</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink_900</item>
        <item name="android:textColorSecondary">@color/ink_500</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="materialButtonStyle">@style/Widget.Superior.Button</item>
        <item name="android:fontFamily" tools:targetApi="jelly_bean">sans</item>
    </style>

    <!-- App theme: light status bar icons off (dark bg), used everywhere -->
    <style name="Theme.SuperiorStudent" parent="Theme.SuperiorStudent.Base" />

    <!-- Splash screen theme with branded window background -->
    <style name="Theme.SuperiorStudent.Splash" parent="Theme.SuperiorStudent.Base">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/pachattar_lime</item>
        <item name="android:navigationBarColor">@color/pachattar_lime</item>
    </style>

    <!-- U2U shares the main app's Paper/Night palette and local Poppins fonts. -->
    <style name="Theme.SuperiorStudent.U2U" parent="Theme.SuperiorStudent">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textViewStyle">@style/Widget.SuperiorStudent.U2U.TextView</item>
        <item name="android:editTextStyle">@style/Widget.SuperiorStudent.U2U.EditText</item>
        <item name="materialButtonStyle">@style/Widget.SuperiorStudent.U2U.Button</item>
    </style>

    <style name="Widget.SuperiorStudent.U2U.TextView" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.SuperiorStudent.U2U.EditText" parent="@android:style/Widget.EditText">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.SuperiorStudent.U2U.Title" parent="@android:style/TextAppearance">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
    <style name="TextAppearance.SuperiorStudent.U2U.Section" parent="@android:style/TextAppearance">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
    <style name="TextAppearance.SuperiorStudent.U2U.Body" parent="@android:style/TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
    <style name="TextAppearance.SuperiorStudent.U2U.Caption" parent="@android:style/TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>
    <style name="TextAppearance.SuperiorStudent.U2U.Label" parent="@android:style/TextAppearance">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>

    <style name="Widget.SuperiorStudent.U2U.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="backgroundTint">@color/sc_purple</item>
        <item name="android:textColor">@color/sc_button_primary_text</item>
    </style>

    <!-- Shared component styles -->
    <style name="Widget.Superior.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily" tools:targetApi="jelly_bean">sans-medium</item>
        <item name="backgroundTint">@color/brand_primary</item>
    </style>

    <style name="TextAppearance.Superior.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:fontFamily" tools:targetApi="jelly_bean">sans-medium</item>
    </style>

    <style name="TextAppearance.Superior.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/ink_500</item>
    </style>
</resources>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".SuperiorStudentApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.SuperiorStudent">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="student_connect_updates" />
        <service
            android:name=".feature.studentconnect.notifications.StudentConnectMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity
            android:name=".feature.transfer.P2pNearbyTransferActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Nearby file transfer" />
        <activity
            android:name=".feature.studentconnect.StudentChatActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="@string/u2u_name"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketOffersActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Market"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketPostTaskStep3Activity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Post a task"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketPostTaskStep2Activity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Post a task"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketPostTaskStep1Activity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Post a task"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketMyTasksActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="My tasks"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketMyOffersActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="My offers"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketPostOfferActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Post an offer"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketOfferDetailActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Offer"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketTaskRatingActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Complete task"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketTaskChatActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Task chat"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketProposalsActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Proposals"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketTaskPosterDetailActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Your task"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketSendProposalActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Send proposal"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketStatesActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="States"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketNoticesActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Notices"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketNoticeDetailActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Notice"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketAppealActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Appeal"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketSuspendedActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Market"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketHelpActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Help and safety"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketTaskDetailActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Task"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.market.ui.MarketRequestsActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="Market"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <activity
            android:name=".feature.studentconnect.StudentConnectActivity"
            android:theme="@style/Theme.SuperiorStudent.U2U"
            android:exported="false"
            android:label="@string/u2u_name" />
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.SuperiorStudent.Splash"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
